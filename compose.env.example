# Compose interpolation settings. Copy to compose.env and replace the values.
# This path must be absolute and must exist on the Docker host.
OPENSAC_CONTAINER_DATA_DIR=/absolute/path/to/opensac-data

# Run the API container as the owner of OPENSAC_CONTAINER_DATA_DIR.
OPENSAC_UID=1000
OPENSAC_GID=1000

# Linux: stat -c '%g' /var/run/docker.sock
# Docker Desktop: keep 0 unless its socket is exposed with another group.
OPENSAC_DOCKER_GID=0

OPENSAC_BIND_ADDRESS=127.0.0.1
OPENSAC_PORT=8000
OPENSAC_CONTAINER_SEARCH_BACKEND=web
OPENSAC_SERVICE_IMAGE=ghcr.io/liuqi6777/opensac:0.6.3
OPENSAC_SANDBOX_IMAGE=ghcr.io/liuqi6777/opensac-sandbox:0.6.3
