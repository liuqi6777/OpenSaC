# Independent capability providers, discovered from installed entry points in the executing process.
OPENSAC_SEARCH_PROVIDER=serper
OPENSAC_SEARCH_API_KEY=
# OPENSAC_SEARCH_BASE_URL=https://google.serper.dev/search
# OPENSAC_SEARCH_OPTIONS={}

OPENSAC_FETCH_PROVIDER=jina
OPENSAC_FETCH_API_KEY=
# OPENSAC_FETCH_BASE_URL=https://r.jina.ai
# OPENSAC_FETCH_OPTIONS={}

# An HTTP capability endpoint can be used independently for either role:
# OPENSAC_SEARCH_PROVIDER=http
# OPENSAC_SEARCH_BASE_URL=http://search-service:9000/v1
# OPENSAC_FETCH_PROVIDER=http
# OPENSAC_FETCH_BASE_URL=http://fetch-service:9001/v1

OPENSAC_REQUEST_TIMEOUT=30
OPENSAC_MAX_CONCURRENCY=8
OPENSAC_MAX_RESPONSE_BYTES=2000000

# Optional rerank capability: POST <base_url>/rerank, Cohere-shaped request/response.
OPENSAC_RERANK_PROVIDER=http
# OPENSAC_RERANK_BASE_URL=http://localhost:9002/v1
# OPENSAC_RERANK_MODEL=your-rerank-model
# OPENSAC_RERANK_API_KEY=
# OPENSAC_RERANK_OPTIONS={}

# Optional LLM capability: POST <base_url>/chat/completions.
OPENSAC_LLM_PROVIDER=openai
# OPENSAC_LLM_BASE_URL=http://localhost:9003/v1
# OPENSAC_LLM_MODEL=your-model
OPENSAC_LLM_MAX_TOKENS=1024
# OPENSAC_LLM_TEMPERATURE=0.2
# OPENSAC_LLM_API_KEY=
# OPENSAC_LLM_OPTIONS={}
