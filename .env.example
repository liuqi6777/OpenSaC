# Public API. Leave API_KEY empty only for local development.
OPENSAC_API_HOST=127.0.0.1
OPENSAC_API_PORT=8000
OPENSAC_API_KEY=
OPENSAC_DATA_DIR=.opensac
OPENSAC_BROKER_SOCKET=.opensac/broker.sock

# OpenAI-compatible control and extraction model.
OPENSAC_MODEL_API_KEY=
OPENSAC_MODEL_BASE_URL=
OPENSAC_MODEL_NAME=
OPENSAC_MODEL_TEMPERATURE=0.1

# Search backends.
OPENSAC_LOCAL_SEARCH_BASE_URL=http://127.0.0.1:8081
OPENSAC_PERPLEXITY_API_KEY=

# Docker sandbox.
OPENSAC_SANDBOX_IMAGE=opensac-sandbox:latest
OPENSAC_SANDBOX_TIMEOUT_SECONDS=120
OPENSAC_SANDBOX_MEMORY=512m
# Set to 0 on hosts whose kernel has no cpu cgroup controller mounted. There
# --cpus makes every container exit 125 with "NanoCPUs can not be set", which
# looks like a broken program rather than a broken host. Check with
# `cat /sys/fs/cgroup/cgroup.controllers` (v2) or `grep cgroup /proc/mounts`
# (v1) and look for `cpu`. Only the CPU quota is lost; the memory and pids
# limits are independent.
OPENSAC_SANDBOX_CPUS=1.0
OPENSAC_SANDBOX_PIDS_LIMIT=64
# Concurrent containers across all sessions. Raise it when an external harness
# runs many rollouts at once, or its /exec calls queue up and time out.
OPENSAC_SANDBOX_MAX_CONCURRENCY=8
